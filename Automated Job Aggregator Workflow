      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Separate Notion (existing) and new jobs\nconst existing = items.map(i => i.json).filter(j => !j.timestamp_added && j.job_id);\nconst newJobs = items.map(i => i.json).filter(j => j.timestamp_added && j.job_id);\n\nconsole.log(`📊 Existing in Notion: ${existing.length}`);\nconsole.log(`📊 Newly scraped: ${newJobs.length}`);\n\n// --- Normalize job_id helper ---\nconst normalizeId = id => id?.toString().trim().replace(/\\D/g, '') || '';\n\n// --- Build set of existing job IDs ---\nconst existingIds = new Set(existing.map(j => normalizeId(j.job_id)).filter(Boolean));\n\n// --- Filter only new unique jobs by job_id ---\nconst seenIds = new Set();\nconst unique = [];\nlet duplicates = 0;\n\nfor (const job of newJobs) {\n  const id = normalizeId(job.job_id);\n  if (!id) continue;\n\n  if (existingIds.has(id) || seenIds.has(id)) {\n    duplicates++;\n    continue;\n  }\n\n  seenIds.add(id);\n  unique.push({ json: job });\n}\n\nconsole.log(`✅ Unique jobs: ${unique.length}`);\nconsole.log(`❌ Duplicates skipped: ${duplicates}`);\n\nreturn unique;\n"
      },
