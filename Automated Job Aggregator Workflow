      "parameters": {
        "jsCode": "// Get plain text from HTTP Request node (stored in json.string)\nconst text = $input.first().json.string;\n\nif (!text || typeof text !== \"string\") {\n  throw new Error(\"❌ README text not found. Check that HTTP Request Response Format = String.\");\n}\n\nconst lines = text.split(/\\r?\\n/);\n\n// Filter job table rows\nconst tableLines = lines.filter(l =>\n  l.includes(\"|\") &&\n  l.includes(\"<a href=\") &&\n  !l.startsWith(\"| ---\") &&\n  !l.startsWith(\"| Company\")\n);\n\nconst jobs = [];\nconst now = new Date();\nconst oneDayAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nfor (const line of tableLines) {\n  const parts = line.split(\"|\").map(p => p.trim());\n\n  const company = (parts[1] || \"\").replace(/\\*\\*/g, \"\");\n  const role = parts[2] || \"\";\n  const location = (parts[3] || \"\").replace(/<\\/?br>/gi, \" | \").trim();\n\n  // Extract actual job URL\n  const linkMatch = (parts[4] || \"\").match(/<a\\s+href=\"([^\"]+)\"/i);\n  const link = linkMatch ? linkMatch[1].trim() : \"\";\n\n  const datePosted = (parts[5] || \"\").trim();\n\n  // Try to parse the datePosted string\n  let postedDate = null;\n  if (datePosted) {\n    // Common formats in GitHub README job boards:\n    // e.g., \"2025-11-08\", \"Nov 8, 2025\", \"11/08/2025\", etc.\n    postedDate = new Date(datePosted);\n  }\n\n  // Keep only if the posting date is within last 24 hours\n  if (postedDate && !isNaN(postedDate.getTime()) && postedDate >= oneDayAgo) {\n    jobs.push({\n      json: { company, role, location, link, date_posted: datePosted }\n    });\n  }\n}\n\nconsole.log(`✅ Extracted ${jobs.length} jobs from GitHub README (last 24 hours only)`);\nreturn jobs;\n"
