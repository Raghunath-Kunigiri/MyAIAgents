        "jsCode": "// Build Discord Webhook Payload\nconst jobs = $input.all().map(i => i.json);\n\nif (!jobs.length) {\n  return [];\n}\n\n// Create rich embeds for Discord (max 10 per message)\nconst embeds = jobs.slice(0, 10).map(job => ({\n  title: job.job_title,\n  url: job.job_url,\n  color: 3447003, // Blue color\n  fields: [\n    {\n      name: \"🏢 Company\",\n      value: job.company_name || \"N/A\",\n      inline: true\n    },\n    {\n      name: \"📍 Location\",\n      value: job.location_full || \"N/A\",\n      inline: true\n    },\n    {\n      name: \"💼 Type\",\n      value: job.employment_type || \"Full-time\",\n      inline: true\n    },\n    {\n      name: \"🏠 Remote\",\n      value: job.remote_option || \"on-site\",\n      inline: true\n    }\n  ],\n  footer: {\n    text: job._source || \"LinkedIn\"\n  },\n  timestamp: new Date().toISOString()\n}));\n\nconst payload = {\n  content: `🔥 **${jobs.length} New Job${jobs.length > 1 ? 's' : ''} Found!**`,\n  embeds: embeds\n};\n\nconsole.log(`Created Discord payload for ${jobs.length} jobs (showing ${embeds.length})`);\n\nreturn [{ json: payload }];"
