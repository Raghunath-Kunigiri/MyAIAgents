    {
      "parameters": {
        "jsCode": "const data = $json.commit;\n\nreturn {\n  content: \"📌 **New Commit Detected!**\",\n  embeds: [\n    {\n      title: `Commit: ${data.sha.substring(0,7)}`,\n      url: data.html_url,\n      description: data.commit.message,\n      color: 15844367,\n      author: {\n        name: data.commit.author.name,\n        icon_url: data.author?.avatar_url || \"\"\n      },\n      fields: [\n        { name: \"SHA\", value: data.sha },\n        { name: \"Date\", value: data.commit.author.date }\n      ],\n      timestamp: new Date().toISOString()\n    }\n  ]\n};\n"
