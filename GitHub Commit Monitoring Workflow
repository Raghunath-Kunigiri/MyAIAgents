      "parameters": {
        "jsCode": "// Extract latest commit from GitHub\nlet latestCommit;\n\nif (Array.isArray($json) && $json.length > 0) {\n  latestCommit = $json[0];\n} else if ($json?.sha) {\n  latestCommit = $json;\n} else {\n  throw new Error(\"❌ No commit found\");\n}\n\n// latest commit SHA\nconst latestSha = latestCommit.sha;\n\n// Read old SHA\nlet oldSha = \"\";\ntry {\n  const raw = $('Read Last Commit').item.binary.data.data;\n  oldSha = Buffer.from(raw, \"base64\").toString(\"utf8\").trim();\n} catch {\n  oldSha = \"\";\n}\n\n// Compare\nconst changed = latestSha !== oldSha;\n\n// Create binary to write\nconst newBinary = Buffer.from(latestSha, \"utf8\").toString(\"base64\");\n\n// Always return BOTH JSON + BINARY\nreturn [\n  {\n    json: {\n      changed,\n      latestSha,\n      oldSha,\n      commit: latestCommit\n    },\n    binary: {\n      data: {\n        data: newBinary,\n        mimeType: \"text/plain\",\n        fileName: \"lastCommit.txt\"\n      }\n    }\n  }\n];\n"
      },
