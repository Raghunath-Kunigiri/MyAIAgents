        "jsCode": "// READ OLD HTML\nlet oldHtml = \"\";\ntry {\n  const bin = $json.data;\n  if (bin?.data) oldHtml = Buffer.from(bin.data, \"base64\").toString(\"utf8\");\n} catch { oldHtml = \"\"; }\n\n// NEW HTML\nconst newHtml = $('Fetch New HTML').item.json.data || \"\";\n\n// CLEAN FUNCTION\nconst clean = html => html.replace(/\\s+/g, \"\").replace(/<script[\\s\\S]*?<\\/script>/gi, \"\");\n\n// COMPARE\nlet changed = clean(oldHtml) !== clean(newHtml);\n\n// ALWAYS RETURN BOTH JSON + BINARY\nreturn [\n{\n  json: { changed },\n  binary: {\n    data: {\n      data: Buffer.from(newHtml, \"utf8\").toString(\"base64\"),\n      mimeType: \"text/html\",\n      fileName: \"News.html\"\n    }\n  }\n}\n];\n"
