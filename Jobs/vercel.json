{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.py"
    },
    {
      "src": "/resume",
      "dest": "index.py"
    },
    {
      "src": "/job_input_form.html",
      "dest": "index.py"
    },
    {
      "src": "/Resume_Generator/(.*)",
      "dest": "index.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ]
}

